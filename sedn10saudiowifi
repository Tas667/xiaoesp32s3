// Utility Functions
void logError(const String& error) {
    state.lastError = error;
    state.lastErrorTime = millis();
    Serial.println("ERROR: " + error);
    digitalWrite(LED_RED, HIGH);  // Turn on error LED
}

void handleLEDs() {
    unsigned long currentMillis = millis();
    
    // Yellow LED - WiFi and activity
    if (WiFi.status() == WL_CONNECTED) {
        if (state.isRecording) {
            // Blink during recording
            if (currentMillis - state.lastYellowBlink >= LED_BLINK_INTERVAL) {
                state.ledYellowState = !state.ledYellowState;
                digitalWrite(LED_YELLOW, state.ledYellowState);
                state.lastYellowBlink = currentMillis;
            }
        } else {
            // Steady on when connected
            digitalWrite(LED_YELLOW, HIGH);
        }
    } else {
        // Fast blink when disconnected
        if (currentMillis - state.lastYellowBlink >= LED_BLINK_INTERVAL/2) {
            state.ledYellowState = !state.ledYellowState;
            digitalWrite(LED_YELLOW, state.ledYellowState);
            state.lastYellowBlink = currentMillis;
        }
    }
    
    // Red LED - Error/Recording status
    if (state.lastError != "" && (currentMillis - state.lastErrorTime < 5000)) {
        digitalWrite(LED_RED, HIGH);
    } else if (state.isRecording) {
        if (currentMillis - state.lastRedBlink >= LED_BLINK_INTERVAL) {
            state.ledRedState = !state.ledRedState;
            digitalWrite(LED_RED, state.ledRedState);
            state.lastRedBlink = currentMillis;
        }
    } else {
        digitalWrite(LED_RED, LOW);
    }
}

void updateSystemMetrics() {
    state.uptime = millis();
    state.freeHeap = ESP.getFreeHeap();
    state.sdUsedBytes = SD.usedBytes();
    state.sdTotalBytes = SD.totalBytes();
}

// Function to Send CORS Headers
void sendCORSHeaders() {
    server.sendHeader("Access-Control-Allow-Origin", "*", true); // 'first=true' ensures it's sent first
    server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
    server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
}

// Web Handlers
void handleRoot() {
    sendCORSHeaders();
    server.send(200, "text/html", index_html);
}

void handleStatus() {
    sendCORSHeaders();
    StaticJsonDocument<512> doc;
    
    doc["uptime"] = state.uptime;
    doc["freeHeap"] = state.freeHeap;
    doc["rssi"] = WiFi.RSSI();
    doc["sdTotalBytes"] = state.sdTotalBytes;
    doc["sdUsedBytes"] = state.sdUsedBytes;
    doc["recordingCount"] = state.recordingCount;
    doc["isRecording"] = state.isRecording;
    doc["lastError"] = state.lastError;
    
    String response;
    serializeJson(doc, response);
    server.send(200, "application/json", response);
}

void handleRecord() {
    sendCORSHeaders();
    Serial.println("   Web request: Start recording");
    File file = SD.open("/rec.wav", FILE_WRITE);
    if(!file) {
        logError("Cannot create WAV file!");
        server.send(500, "text/plain", "SD error");
        return;
    }
    Serial.println("   Recording file created");

    // Write WAV header
    Serial.println("   Writing WAV header...");
    byte header[44] = {
        'R','I','F','F',    // RIFF
        0,0,0,0,            // Size (updated later)
        'W','A','V','E',    // WAVE
        'f','m','t',' ',    // fmt
        16,0,0,0,           // fmt size
        1,0,                // Format = PCM
        1,0,                // Channels = 1
        0x80,0x3E,0,0,      // Sample rate (16000)
        0,0x7D,0,0,         // Byte rate (SampleRate * NumChannels * BitsPerSample/8)
        2,0,                // Block align
        16,0,               // Bits per sample
        'd','a','t','a',    // data
        0,0,0,0             // Data size (updated later)
    };
    file.write(header, 44);

    // Record for 10 seconds
    Serial.println("   Starting 10s recording...");
    unsigned long startTime = millis();
    state.isRecording = true;
    int bytesWritten = 0;
    int progressDot = 0;
    
    while((millis() - startTime) < (RECORD_TIME * 1000)) {
        int16_t sample = I2S.read();
        if(sample != -1) {
            file.write((byte*)&sample, 2);
            bytesWritten += 2;
        }
        // Print progress dots
        if((millis() - startTime) / 1000 > progressDot) {
            Serial.print(".");
            progressDot++;
        }
        handleLEDs();  // Update LEDs during recording
    }
    
    state.isRecording = false;
    Serial.println("\n   Recording finished");
    Serial.println("   Bytes written: " + String(bytesWritten));

    // Update WAV header with final size
    Serial.println("   Updating WAV header...");
    file.seek(4);
    unsigned int fileSize = bytesWritten + 36;
    file.write((byte*)&fileSize, 4);
    file.seek(40);
    file.write((byte*)&bytesWritten, 4);
    
    file.close();
    state.recordingCount++;
    Serial.println("   File saved successfully");
    server.send(200, "text/plain", "Done");
}

void handlePlay() {
    sendCORSHeaders();
    Serial.println("   Web request: Play recording");
    File file = SD.open("/rec.wav");
    if(!file) {
        logError("Cannot open WAV file!");
        server.send(500, "text/plain", "File error");
        return;
    }
    Serial.println("   Streaming file to client...");
    server.sendHeader("Content-Type", "audio/wav");
    server.streamFile(file, "audio/wav");
    file.close();
    Serial.println("   Streaming complete");
}

void handleNotFound() {
    sendCORSHeaders();
    logError("Invalid web request: " + server.uri());
    server.send(404, "text/plain", "Not found");
}

void setup() {
    Serial.begin(115200);
    Serial.println("\n\n=== Starting XIAO Audio System ===");
    
    // Initialize LEDs
    pinMode(LED_YELLOW, OUTPUT);
    pinMode(LED_RED, OUTPUT);
    digitalWrite(LED_YELLOW, LOW);
    digitalWrite(LED_RED, LOW);
    
    // Init SD
    Serial.println("1. Initializing SD card...");
    if(!SD.begin(SD_CS)) {
        logError("SD card initialization failed!");
        while(1) {
            delay(1000);
            Serial.println("SD card error - check connections");
        }
    }
    Serial.println("   SD card initialized successfully!");

    // Init I2S
    Serial.println("2. Initializing I2S...");
    I2S.setPinsPdmRx(I2S_WS, I2S_SD);
    if (!I2S.begin(I2S_MODE_PDM_RX, SAMPLE_RATE, I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_MONO)) {
        logError("I2S initialization failed!");
        while(1) {
            delay(1000);
            Serial.println("I2S error - check microphone");
        }
    }
    Serial.println("   I2S initialized successfully!");

    // Test microphone
    Serial.println("3. Testing microphone...");
    int16_t sample = I2S.read();
    Serial.println("   Mic test value: " + String(sample));
    if(sample == -1) {
        Serial.println("WARNING: Microphone might not be working properly");
    }

    // Connect WiFi
    Serial.println("4. Connecting to WiFi...");
    Serial.println("   SSID: " + String(ssid));
    WiFi.begin(ssid, password);
    int wifiAttempts = 0;
    while (WiFi.status() != WL_CONNECTED && wifiAttempts < 20) {
        delay(500);
        digitalWrite(LED_YELLOW, !digitalRead(LED_YELLOW));  // Blink while connecting
        Serial.print(".");
        wifiAttempts++;
    }
    if(WiFi.status() != WL_CONNECTED) {
        logError("WiFi connection failed!");
        while(1) {
            delay(1000);
            Serial.println("WiFi error - check credentials");
        }
    }
    Serial.println("\n   WiFi connected successfully!");
    Serial.println("   IP address: " + WiFi.localIP().toString());

    // Setup web routes
    Serial.println("5. Setting up web server...");
    
    server.on("/", HTTP_GET, handleRoot);
    server.on("/status", HTTP_GET, handleStatus);

    // Handle OPTIONS for CORS preflight
    server.on("/record", HTTP_OPTIONS, [](){
        sendCORSHeaders();
        server.send(200, "text/plain", "");
    });
    server.on("/record", HTTP_GET, handleRecord);

    server.on("/play", HTTP_OPTIONS, [](){
        sendCORSHeaders();
        server.send(200, "text/plain", "");
    });
    server.on("/play", HTTP_GET, handlePlay);

    // Handle 404 Not Found
    server.onNotFound(handleNotFound);

    server.begin();
    Serial.println("   Web server started");
    digitalWrite(LED_YELLOW, HIGH);  // Show system is ready
    Serial.println("\n=== Setup Complete ===");
    Serial.println("Open http://" + WiFi.localIP().toString() + " in your browser");
    
    // Initialize system metrics
    updateSystemMetrics();
}

void loop() {
    server.handleClient();
    handleLEDs();
    
    // Update system metrics periodically
    static unsigned long lastMetricsUpdate = 0;
    if (millis() - lastMetricsUpdate > 1000) {
        updateSystemMetrics();
        lastMetricsUpdate = millis();
    }
    
    // Monitor WiFi connection
    static unsigned long lastWifiCheck = 0;
    if (millis() - lastWifiCheck > 10000) {  // Check every 10 seconds
        lastWifiCheck = millis();
        if (WiFi.status() != WL_CONNECTED) {
            Serial.println("WARNING: WiFi disconnected! Reconnecting...");
            WiFi.reconnect();
        }
    }
    
    delay(10);  // Prevent watchdog reset
}
